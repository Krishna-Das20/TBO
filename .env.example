# Copy to .env and fill in. Never commit .env.

# --- Gemini (AI Studio). Comma-separated keys from ONE project are allowed for
# zero-downtime rotation: revoked/invalid keys are skipped. Quota is per project,
# so extra keys do NOT add quota, and 429s never hop keys.
GEMINI_API_KEYS=
# Model chain, tried in order when a model is rate-limited (each has its own limit).
HAWK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Optional overflow on Vertex AI (bills GCP credits; prompts not used for training).
HAWK_VERTEX_PROJECT=
HAWK_VERTEX_LOCATION=us-central1

# --- Databases (Neon Postgres in cloud; SQLite locally when empty)
VOYAGE_DATABASE_URL=
HAWK_DATABASE_URL=

# --- Voyage (the test platform)
VOYAGE_JWT_SECRET=change-me-voyage
VOYAGE_OPS_TOKEN=change-me-ops
# Where Voyage posts deploy events (HAWK control plane)
VOYAGE_DEPLOY_WEBHOOK=http://127.0.0.1:8090/events/deploy
HAWK_WEBHOOK_SECRET=change-me-webhook

# --- Safety gateway
GATEWAY_URL=http://127.0.0.1:8088
GATEWAY_ADMIN_TOKEN=change-me-gateway
